# OS and editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Local environment and caches
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node/Astro caches if this static site is migrated later
node_modules/
.astro/
dist/
.vercel/
.netlify/
*.log

# Temporary/generated local files
tmp/
temp/
*.tmp

# Original photo drop folder.
# The published gallery uses assets/images/photography/curated/ via data/photos.json.
assets/images/photography/gallery/

# Large source photo formats should stay local unless intentionally exported.
*.arw
*.cr2
*.cr3
*.dng
*.nef
*.raf
*.raw
*.heic

# Resume tools, intermediate build files, and original personal drafts (local only).
# Final PDFs directly under resume/ are intentionally tracked for GitHub Pages.
/resume/.tools/
/resume/.archive/
/resume/source/build/
/resume/source/*.aux
/resume/source/*.out
/resume/source/*.fls
/resume/source/*.fdb_latexmk
/resume/source/*.synctex.gz
/resume/source/*.xdv
/resume/source/*.pdf
